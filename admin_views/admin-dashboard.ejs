<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Thingy Admin – Console Deck</title>
    <style>
        body {
            background: #121212;
            color: white;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            margin: 0;
            padding: 20px;
        }

        h1,
        h2 {
            margin: 0 0 10px;
        }

        .section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #333;
        }

        .meta {
            font-size: 0.85rem;
            color: #aaa;
            margin-bottom: 15px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: #1b1b1b;
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 0 0 1px #222;
        }

        .card-half {
            flex: 1 1 280px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 2px;
            color: #ccc;
        }

        input,
        button {
            margin: 2px 0 8px;
            padding: 6px 8px;
            border-radius: 4px;
            border: 1px solid #333;
            background: #181818;
            color: white;
            font-size: 0.9rem;
        }

        input:focus {
            outline: none;
            border-color: #1db954;
        }

        button {
            cursor: pointer;
            border: none;
            background: #1db954;
            font-weight: 600;
        }

        button:hover {
            filter: brightness(1.05);
        }

        button.danger {
            background: #c0392b;
        }

        button.secondary {
            background: #444;
        }

        .app-row {
            border-bottom: 1px solid #333;
            padding: 8px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .app-row.selected {
            background: #1e1e1e;
        }

        .app-info {
            flex: 1 1 auto;
        }

        .app-actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .pill {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 999px;
            background: #2c3e50;
            font-size: 0.7rem;
            margin-top: 4px;
            color: #ddd;
        }

        .empty-hint {
            font-size: 0.9rem;
            color: #888;
        }
    </style>
</head>

<body>
    <h1>Thingy Admin – Console Deck</h1>
    <div class="meta">
        Device IP: <strong>
            <%= ip %>
        </strong> • UI port: <strong>
            <%= port %>
        </strong> •
        WiFi configured: <strong>
            <%= wifiConfigured ? "yes" : "no" %>
        </strong>
    </div>

    <div class="row section">
        <div class="card card-half">
            <h2>Add New App</h2>
            <form id="addForm">
                <input type="text" name="name" placeholder="Name" required>
                
                <label>Command Type:</label>
                <select id="commandType" name="commandType" style="width:100%; padding:6px; margin-bottom:8px; background:#181818; color:white; border:1px solid #333; border-radius:4px;">
                    <option value="exe">Launch Application/File</option>
                    <option value="macro">Keyboard Macro</option>
                </select>

                <div id="exeCommandInput">
                    <input type="text" name="exePath" id="exePath" placeholder="Full path to file" required>
                    <button type="button" onclick="browseForExe()" style="width:100%; margin-bottom:8px;">Browse for file</button>
                </div>

                <div id="macroCommandInput" style="display:none;">
                    <input type="text" name="macroKeys" id="macroKeys" placeholder="e.g., alt a, ctrl shift esc, win d">
                    <small style="color:#aaa; display:block; margin-bottom:8px;">Examples: "alt tab", "ctrl c", "win r"</small>
                </div>

                <input type="text" name="icon" placeholder="Icon URL (optional)">
                <input type="text" name="color" placeholder="#RRGGBB (optional)">
                <input type="text" name="category" placeholder="Category (optional)">

                <label style="display:block; margin-top:4px; font-size:0.85rem;">
                    <input type="checkbox" id="showLabel" name="showLabel" checked>
                    Show text overlay on tile
                </label>

                <button type="submit">Add</button>
            </form>

        </div>

        <div class="card card-half">
            <h2>Selected App</h2>
            <% if (config.selectedAppId) { const current=config.apps.find(a=> a.id === config.selectedAppId);
                %>
                <% if (current) { %>
                    <p><strong>
                            <%= current.name %>
                        </strong></p>
                    <p><small>
                            <%= current.pcCommand %>
                        </small></p>
                    <% if (current.category) { %>
                        <span class="pill">
                            <%= current.category %>
                        </span>
                        <% } %>
                            <% if (current.color) { %>
                                <span class="pill">color: <%= current.color %></span>
                                <% } %>
                                    <% } else { %>
                                        <p class="empty-hint">The selected app no longer exists.</p>
                                        <% } %>
                                            <% } else { %>
                                                <p class="empty-hint">No app selected yet. Click "Select" on an app below.</p>
                                                <% } %>
        </div>
    </div>

    <div class="section">
        <h2>Existing Apps</h2>

        <div id="apps">
            <% config.apps.forEach(app=> { %>
                <div class="app-row <%= config.selectedAppId === app.id ? 'selected' : '' %>" data-id="<%= app.id %>"
                    data-name="<%- app.name %>" data-pc-command="<%- app.pcCommand %>" data-icon="<%- app.icon || '' %>"
                    data-color="<%- app.color || '' %>" data-category="<%- app.category || '' %>"
                    data-show-label="<%= app.showLabel === false ? 'false' : 'true' %>">

                    <div>
                        <strong>
                            <%= app.name %>
                        </strong><br>
                        <small>
                            <%= app.pcCommand %>
                        </small><br>
                        <small>
                            <%= app.category || '' %>
                        </small><br>
                        <small>Overlay: <%= app.showLabel===false ? 'off' : 'on' %></small>
                    </div>

                    <button class="select-btn">Select</button>
                    <button class="edit-btn">Edit</button>
                    <button class="delete-btn">Delete</button>
                </div>
                <% }) %>
        </div>

    </div>

    <script>
        let editingAppId = null;
        
        const addForm = document.getElementById('addForm');
        const appsContainer = document.getElementById('apps');
        const commandTypeSelect = document.getElementById('commandType');
        const exeCommandInput = document.getElementById('exeCommandInput');
        const macroCommandInput = document.getElementById('macroCommandInput');

        // Toggle command type inputs
        commandTypeSelect.addEventListener('change', () => {
            const type = commandTypeSelect.value;
            if (type === 'exe') {
                exeCommandInput.style.display = 'block';
                macroCommandInput.style.display = 'none';
                document.getElementById('exePath').required = true;
                document.getElementById('macroKeys').required = false;
            } else {
                exeCommandInput.style.display = 'none';
                macroCommandInput.style.display = 'block';
                document.getElementById('exePath').required = false;
                document.getElementById('macroKeys').required = true;
            }
        });

        // Browse for exe file using server-side file dialog
        async function browseForExe() {
            const appName = addForm.name.value.trim();
            
            try {
                const res = await fetch('/api/consoledeck/browse-exe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ appName })
                });

                const data = await res.json();
                
                if (res.ok && data.exePath) {
                    document.getElementById('exePath').value = data.exePath;
                } else {
                    alert('Error: ' + (data.error || 'Failed to select file'));
                }
            } catch (err) {
                console.error('Browse failed:', err);
                alert('Failed to open file browser');
            }
        }

        addForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(addForm);
            const body = Object.fromEntries(formData.entries());
            body.showLabel = document.getElementById('showLabel').checked;

            // Build the pcCommand based on command type
            const commandType = body.commandType;
            if (commandType === 'exe') {
                body.pcCommand = body.exePath;
            } else if (commandType === 'macro') {
                body.pcCommand = `.\\macro-maker\\macro.exe ${body.macroKeys}`;
            }

            // Remove the temporary fields
            delete body.commandType;
            delete body.exePath;
            delete body.macroKeys;

            let url;
            let method;

            if (editingAppId) {
                // EDIT
                url = '/api/consoledeck/apps/' + encodeURIComponent(editingAppId);
                method = 'PUT';
            } else {
                // NEW APP
                url = '/api/consoledeck/apps';
                method = 'POST';
            }

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const app = await res.json();

                if (!res.ok) {
                    alert('Error: ' + (app.error || 'unknown'));
                    return;
                }

                if (editingAppId) {
                    // Update UI for existing row
                    const row = appsContainer.querySelector(`.app-row[data-id="${editingAppId}"]`);
                    if (row) {
                        row.dataset.name = app.name;
                        row.dataset.pcCommand = app.pcCommand;
                        row.dataset.icon = app.icon || '';
                        row.dataset.color = app.color || '';
                        row.dataset.category = app.category || '';
                        row.dataset.showLabel = app.showLabel === false ? 'false' : 'true';

                        row.querySelector('strong').textContent = app.name;
                        const smalls = row.querySelectorAll('small');
                        if (smalls[0]) smalls[0].textContent = app.pcCommand;
                        if (smalls[1]) smalls[1].textContent = app.category || '';
                        if (smalls[2]) smalls[2].textContent = 'Overlay: ' + (app.showLabel === false ? 'off' : 'on');
                    }
                } else {
                    // Add new row
                    const row = document.createElement('div');
                    row.className = 'app-row';
                    row.dataset.id = app.id;
                    row.dataset.name = app.name;
                    row.dataset.pcCommand = app.pcCommand;
                    row.dataset.icon = app.icon || '';
                    row.dataset.color = app.color || '';
                    row.dataset.category = app.category || '';
                    row.dataset.showLabel = app.showLabel === false ? 'false' : 'true';

                    row.innerHTML = `
                <div>
                    <strong>${app.name}</strong><br>
                    <small>${app.pcCommand}</small><br>
                    <small>${app.category || ''}</small><br>
                    <small>Overlay: ${app.showLabel === false ? 'off' : 'on'}</small>
                </div>
                <button class="select-btn">Select</button>
                <button class="edit-btn">Edit</button>
                <button class="delete-btn">Delete</button>
            `;
                    appsContainer.appendChild(row);
                }

                // Form reset
                addForm.reset();
                document.getElementById('showLabel').checked = true;
                commandTypeSelect.value = 'exe';
                exeCommandInput.style.display = 'block';
                macroCommandInput.style.display = 'none';
                editingAppId = null;
                addForm.querySelector('button[type="submit"]').textContent = 'Add';
            } catch (err) {
                console.error(err);
                alert('Unknown error');
            }
        });

        appsContainer.addEventListener('click', async (e) => {
            const row = e.target.closest('.app-row');
            if (!row) return;
            const id = row.dataset.id;

            // SELECT
            if (e.target.classList.contains('select-btn')) {
                try {
                    const res = await fetch('/api/consoledeck/select', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id })
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        alert('Error selecting: ' + (data.error || 'unknown'));
                        return;
                    }

                    document.querySelectorAll('.app-row').forEach(r => r.classList.remove('selected'));
                    row.classList.add('selected');
                } catch (err) {
                    console.error(err);
                    alert('Unknown error selecting');
                }
            }

            // EDIT
            if (e.target.classList.contains('edit-btn')) {
                editingAppId = id;

                // Fill form fields from data attributes
                addForm.name.value = row.dataset.name || '';
                const pcCommand = row.dataset.pcCommand || '';
                
                // Detect command type
                if (pcCommand.includes('macro.exe')) {
                    commandTypeSelect.value = 'macro';
                    exeCommandInput.style.display = 'none';
                    macroCommandInput.style.display = 'block';
                    // Extract keys from ".\macro.exe alt a" format
                    const keys = pcCommand.replace(/.*macro\.exe\s+/, '');
                    document.getElementById('macroKeys').value = keys;
                    document.getElementById('exePath').required = false;
                    document.getElementById('macroKeys').required = true;
                } else {
                    commandTypeSelect.value = 'exe';
                    exeCommandInput.style.display = 'block';
                    macroCommandInput.style.display = 'none';
                    document.getElementById('exePath').value = pcCommand;
                    document.getElementById('exePath').required = true;
                    document.getElementById('macroKeys').required = false;
                }

                addForm.icon.value = row.dataset.icon || '';
                addForm.color.value = row.dataset.color || '';
                addForm.category.value = row.dataset.category || '';
                document.getElementById('showLabel').checked = (row.dataset.showLabel !== 'false');

                addForm.querySelector('button[type="submit"]').textContent = 'Save';
            }

            // DELETE
            if (e.target.classList.contains('delete-btn')) {
                if (!confirm('Delete this app?')) return;
                try {
                    const res = await fetch('/api/consoledeck/apps/' + encodeURIComponent(id), {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        alert('Error deleting: ' + (data.error || 'unknown'));
                        return;
                    }
                    row.remove();
                } catch (err) {
                    console.error(err);
                    alert('Unknown error deleting');
                }
            }
        });
    </script>
</body>

</html>