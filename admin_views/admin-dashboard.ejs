<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Thingy Admin – Console Deck</title>
    <style>
        body {
            background: #121212;
            color: white;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            margin: 0;
            padding: 20px;
        }

        h1,
        h2 {
            margin: 0 0 10px;
        }

        .section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #333;
        }

        .meta {
            font-size: 0.85rem;
            color: #aaa;
            margin-bottom: 15px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: #1b1b1b;
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 0 0 1px #222;
        }

        .card-half {
            flex: 1 1 280px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 2px;
            color: #ccc;
        }

        input,
        button {
            margin: 2px 0 8px;
            padding: 6px 8px;
            border-radius: 4px;
            border: 1px solid #333;
            background: #181818;
            color: white;
            font-size: 0.9rem;
        }

        input:focus {
            outline: none;
            border-color: #1db954;
        }

        button {
            cursor: pointer;
            border: none;
            background: #1db954;
            font-weight: 600;
        }

        button:hover {
            filter: brightness(1.05);
        }

        button.danger {
            background: #c0392b;
        }

        button.secondary {
            background: #444;
        }

        .app-row {
            border-bottom: 1px solid #333;
            padding: 8px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .app-row.selected {
            background: #1e1e1e;
        }

        .app-info {
            flex: 1 1 auto;
        }

        .app-actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .pill {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 999px;
            background: #2c3e50;
            font-size: 0.7rem;
            margin-top: 4px;
            color: #ddd;
        }

        .empty-hint {
            font-size: 0.9rem;
            color: #888;
        }
    </style>
</head>

<body>
    <h1>Thingy Admin – Console Deck</h1>
    <div class="meta">
        Device IP: <strong>
            <%= ip %>
        </strong> • UI port: <strong>
            <%= port %>
        </strong> •
        WiFi configured: <strong>
            <%= wifiConfigured ? "yes" : "no" %>
        </strong>
    </div>

    <div class="row section">
        <div class="card card-half">
            <h2>Nieuwe app toevoegen</h2>
            <form id="addForm">
                <input type="text" name="name" placeholder="Naam" required>
                <input type="text" name="pcCommand" placeholder="PC command" required>
                <input type="text" name="icon" placeholder="Icon URL (optional)">
                <input type="text" name="color" placeholder="#RRGGBB (optional)">
                <input type="text" name="category" placeholder="Categorie (optional)">

                <label style="display:block; margin-top:4px; font-size:0.85rem;">
                    <input type="checkbox" id="showLabel" name="showLabel" checked>
                    Tekst overlay tonen op tile
                </label>

                <button type="submit">Toevoegen</button>
            </form>

        </div>

        <div class="card card-half">
            <h2>Geselecteerde app</h2>
            <% if (config.selectedAppId) { const current=config.apps.find(a=> a.id === config.selectedAppId);
                %>
                <% if (current) { %>
                    <p><strong>
                            <%= current.name %>
                        </strong></p>
                    <p><small>
                            <%= current.pcCommand %>
                        </small></p>
                    <% if (current.category) { %>
                        <span class="pill">
                            <%= current.category %>
                        </span>
                        <% } %>
                            <% if (current.color) { %>
                                <span class="pill">kleur: <%= current.color %></span>
                                <% } %>
                                    <% } else { %>
                                        <p class="empty-hint">De geselecteerde app bestaat niet meer.</p>
                                        <% } %>
                                            <% } else { %>
                                                <p class="empty-hint">Nog geen app geselecteerd. Klik op "Selecteren"
                                                    bij een app hieronder.</p>
                                                <% } %>
        </div>
    </div>

    <div class="section">
        <h2>Bestaande apps</h2>

        <div id="apps">
            <% config.apps.forEach(app=> { %>
                <div class="app-row <%= config.selectedAppId === app.id ? 'selected' : '' %>" data-id="<%= app.id %>"
                    data-name="<%- app.name %>" data-pc-command="<%- app.pcCommand %>" data-icon="<%- app.icon || '' %>"
                    data-color="<%- app.color || '' %>" data-category="<%- app.category || '' %>"
                    data-show-label="<%= app.showLabel === false ? 'false' : 'true' %>">

                    <div>
                        <strong>
                            <%= app.name %>
                        </strong><br>
                        <small>
                            <%= app.pcCommand %>
                        </small><br>
                        <small>
                            <%= app.category || '' %>
                        </small><br>
                        <small>Overlay: <%= app.showLabel===false ? 'uit' : 'aan' %></small>
                    </div>

                    <button class="select-btn">Selecteren</button>
                    <button class="edit-btn">Bewerken</button>
                    <button class="delete-btn">Verwijderen</button>
                </div>
                <% }) %>
        </div>

    </div>

    <script>
        let editingAppId = null;
        
        const addForm = document.getElementById('addForm');
        const appsContainer = document.getElementById('apps');

        addForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(addForm);
            const body = Object.fromEntries(formData.entries());
            body.showLabel = document.getElementById('showLabel').checked;

            let url;
            let method;

            if (editingAppId) {
                // BEWERKEN
                url = '/api/consoledeck/apps/' + encodeURIComponent(editingAppId);
                method = 'PUT';
            } else {
                // NIEUWE APP
                url = '/api/consoledeck/apps';
                method = 'POST';
            }

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const app = await res.json();

                if (!res.ok) {
                    alert('Fout: ' + (app.error || 'unknown'));
                    return;
                }

                if (editingAppId) {
                    // UI updaten voor bestaande row
                    const row = appsContainer.querySelector(`.app-row[data-id="${editingAppId}"]`);
                    if (row) {
                        row.dataset.name = app.name;
                        row.dataset.pcCommand = app.pcCommand;
                        row.dataset.icon = app.icon || '';
                        row.dataset.color = app.color || '';
                        row.dataset.category = app.category || '';
                        row.dataset.showLabel = app.showLabel === false ? 'false' : 'true';

                        row.querySelector('strong').textContent = app.name;
                        const smalls = row.querySelectorAll('small');
                        if (smalls[0]) smalls[0].textContent = app.pcCommand;
                        if (smalls[1]) smalls[1].textContent = app.category || '';
                        if (smalls[2]) smalls[2].textContent = 'Overlay: ' + (app.showLabel === false ? 'uit' : 'aan');
                    }
                } else {
                    // Nieuwe row toevoegen
                    const row = document.createElement('div');
                    row.className = 'app-row';
                    row.dataset.id = app.id;
                    row.dataset.name = app.name;
                    row.dataset.pcCommand = app.pcCommand;
                    row.dataset.icon = app.icon || '';
                    row.dataset.color = app.color || '';
                    row.dataset.category = app.category || '';
                    row.dataset.showLabel = app.showLabel === false ? 'false' : 'true';

                    row.innerHTML = `
                <div>
                    <strong>${app.name}</strong><br>
                    <small>${app.pcCommand}</small><br>
                    <small>${app.category || ''}</small><br>
                    <small>Overlay: ${app.showLabel === false ? 'uit' : 'aan'}</small>
                </div>
                <button class="select-btn">Selecteren</button>
                <button class="edit-btn">Bewerken</button>
                <button class="delete-btn">Verwijderen</button>
            `;
                    appsContainer.appendChild(row);
                }

                // Form reset
                addForm.reset();
                document.getElementById('showLabel').checked = true;
                editingAppId = null;
                addForm.querySelector('button[type="submit"]').textContent = 'Toevoegen';
            } catch (err) {
                console.error(err);
                alert('Onbekende fout');
            }
        });

        appsContainer.addEventListener('click', async (e) => {
            const row = e.target.closest('.app-row');
            if (!row) return;
            const id = row.dataset.id;

            // SELECT
            if (e.target.classList.contains('select-btn')) {
                try {
                    const res = await fetch('/api/consoledeck/select', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id })
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        alert('Fout bij selecteren: ' + (data.error || 'unknown'));
                        return;
                    }

                    document.querySelectorAll('.app-row').forEach(r => r.classList.remove('selected'));
                    row.classList.add('selected');
                } catch (err) {
                    console.error(err);
                    alert('Onbekende fout bij selecteren');
                }
            }

            // EDIT
            if (e.target.classList.contains('edit-btn')) {
                editingAppId = id;

                // form velden vullen vanuit data attrs
                addForm.name.value = row.dataset.name || '';
                addForm.pcCommand.value = row.dataset.pcCommand || '';
                addForm.icon.value = row.dataset.icon || '';
                addForm.color.value = row.dataset.color || '';
                addForm.category.value = row.dataset.category || '';
                document.getElementById('showLabel').checked = (row.dataset.showLabel !== 'false');

                addForm.querySelector('button[type="submit"]').textContent = 'Opslaan';
            }

            // DELETE
            if (e.target.classList.contains('delete-btn')) {
                if (!confirm('Deze app verwijderen?')) return;
                try {
                    const res = await fetch('/api/consoledeck/apps/' + encodeURIComponent(id), {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        alert('Fout bij verwijderen: ' + (data.error || 'unknown'));
                        return;
                    }
                    row.remove();
                } catch (err) {
                    console.error(err);
                    alert('Onbekende fout bij verwijderen');
                }
            }
        });
    </script>
</body>

</html>