<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/spotify/css/dash.css">
    <link rel="stylesheet" href="/global.css">
    <script src="/js/time-utils.js"></script>
</head>
<body>
  <div class="spotify-home-page-playing-song">
    <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png"></img>
    <div class="clock time">00:00</div>
    <img class="spotify-logo" src="/spotify/img/spotify.png" />
    

    <div class="nowplaying" onclick="location='/spotify/?view=nowplaying'">
      <img id="cover" src="" alt="Album cover" style="width: 100%; height: 100%; object-fit: cover; border-radius: 35px;" />
    </div>
    <div class="cotrols">
      <img id="nextBtn" class="forward-button" src="/spotify/img/forward-button.png" />
      <img id="prevBtn" class="reverse-button" src="/spotify/img/forward-button.png" />
      <img id="playBtn" class="pause" src="/spotify/img/pause.png" data-play="/spotify/img/play.png" data-pause="/spotify/img/pause.png" />
    </div>

    <div class="song-info">
      <div id="artist" class="artist">Artist</div>
      <div id="track" class="song-name">Song name</div>
    </div>
    
    <div class="timeline">
      <div class="timeline-whole"></div>
      <div class="timeline-current-time"></div>
      <div id="totalTime" class="song-length">0:00</div>
      <div id="currentTime" class="song-current-time">0:00</div>
      <input id="timelineSlider" type="range" min="0" max="100" value="0" style="position: absolute; left: 504px; top: 362px; width: 200px; height: 10px; opacity: 0; cursor: pointer; z-index: 10;">
    </div>


    <div class="apps">
      <div class="recently-played" onclick="location='/spotify/?view=recent'"></div>
      <img class="recently-played-icon" src="/spotify/img/history.png" />
      <div class="search"></div>
      <img class="search-icon" src="/spotify/img/search.png" />
      <div class="likedplaylist" onclick="location='/spotify/?view=likedplaylist'"></div>
      <img class="likedplaylist-icon" src="/spotify/img/heart-2.png" />
      <div class="playlist-list"></div>
      <img class="playlist-list-icon" src="/spotify/img/list-text.png" />
    </div>  
  </div>

  <script>
    function msToTime(ms) {
      const m = Math.floor(ms / 60000);
      const s = Math.floor((ms % 60000) / 1000);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    let currentTrackId = "";
    let lastProgress = 0;
    let lastTimestamp = 0;
    let trackDuration = 0;
    let isPlaying = false;

    async function refreshPlayer() {
      try {
        const r = await fetch("/api/playback");
        const d = await r.json();
        const playBtn = document.getElementById("playBtn");

        if (!d || (!d.track && !d.artist)) {
          document.getElementById("track").innerText = "No track playing";
          document.getElementById("artist").innerText = "Play something on Spotify";
          return;
        }

        // Sync play/pause icon with real Spotify state
        if (playBtn) {
          if (d.isPlaying) {
            playBtn.src = playBtn.dataset.pause;
          } else {
            playBtn.src = playBtn.dataset.play;
          }
        }

        currentTrackId = d.id || "";
        document.getElementById("track").innerText = d.track || "-";
        document.getElementById("artist").innerText = d.artist || "-";

        // Update album cover
        if (d.cover) {
          document.getElementById("cover").src = d.cover;
        }

        const timeline = document.getElementById("timelineSlider");
        const timelineCurrent = document.querySelector(".timeline-current-time");

        trackDuration = d.duration || 0;
        lastProgress = d.progress || 0;
        lastTimestamp = Date.now();
        isPlaying = !!d.isPlaying;

        if (timeline) {
          timeline.max = trackDuration || 0;
          timeline.value = lastProgress || 0;
        }

        document.getElementById("currentTime").innerText = msToTime(lastProgress);
        document.getElementById("totalTime").innerText = msToTime(trackDuration);

        // Update timeline visual progress (200px is the full width from CSS)
        if (timelineCurrent && trackDuration > 0) {
          const fraction = lastProgress / trackDuration;
          timelineCurrent.style.width = `${fraction * 200}px`;
        }
      } catch (e) {
        console.error("Failed to refresh player:", e);
      }
    }

    function smoothUpdate() {
      const timeline = document.getElementById("timelineSlider");
      const timelineCurrent = document.querySelector(".timeline-current-time");
      if (!timeline || !trackDuration) return;

      let current = lastProgress;

      if (isPlaying) {
        const elapsed = Date.now() - lastTimestamp;
        current = lastProgress + elapsed;
        if (current > trackDuration) current = trackDuration;
      }

      timeline.value = current;
      document.getElementById("currentTime").innerText = msToTime(current);

      // Update timeline visual progress (200px is the full width from CSS)
      if (timelineCurrent && trackDuration > 0) {
        const fraction = current / trackDuration;
        timelineCurrent.style.width = `${fraction * 200}px`;
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const timeline = document.getElementById("timelineSlider");
      const prevBtn = document.getElementById("prevBtn");
      const playBtn = document.getElementById("playBtn");
      const nextBtn = document.getElementById("nextBtn");

      // Seek timeline
      if (timeline) {
        timeline.addEventListener("input", function () {
          fetch(`/api/seek?position=${this.value}`);
          lastProgress = Number(this.value);
          lastTimestamp = Date.now();

          const timelineCurrent = document.querySelector(".timeline-current-time");
          if (timelineCurrent && trackDuration > 0) {
            const fraction = lastProgress / trackDuration;
            timelineCurrent.style.width = `${fraction * 200}px`;
          }
        });
      }

      // Previous track
      if (prevBtn) {
        prevBtn.addEventListener("click", async () => {
          try {
            await fetch("/api/prev");
            setTimeout(refreshPlayer, 300);
          } catch (e) {
            console.error(e);
          }
        });
      }

      // Play/Pause toggle
      if (playBtn) {
        playBtn.addEventListener("click", async () => {
          try {
            await fetch("/api/playpause");
            setTimeout(refreshPlayer, 300);
          } catch (e) {
            console.error(e);
          }
        });
      }

      // Next track
      if (nextBtn) {
        nextBtn.addEventListener("click", async () => {
          try {
            await fetch("/api/next");
            setTimeout(refreshPlayer, 300);
          } catch (e) {
            console.error(e);
          }
        });
      }

      // Initial load and polling
      refreshPlayer();
      const POLL_INTERVAL = 1000;
      setInterval(refreshPlayer, POLL_INTERVAL);
      setInterval(smoothUpdate, 100);
    });
  </script>
  <script>
    initLiveClock();
  </script>
</body>
</html>