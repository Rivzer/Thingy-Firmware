<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/spotify/css/dash.css">
    <link rel="stylesheet" href="/global.css">
</head>
<body>
    <div class="spotify-home-page-playing-song">
  <div class="rectangle-25" onclick="location='/spotify?view=nowplaying'"></div>
  <img class="forward-button-1" src="/spotify/img/forward-button.png" />
  <div class="group-22">
    <div class="rectangle-16"></div>
    <div class="rectangle-17"></div>
  </div>
  <div class="_3-23">3:23</div>
  <div class="_1-34">1:34</div>
  <img class="forward-button-2" src="/spotify/img/forward-button.png" />
  <img class="pause-1" src="/spotify/img/pause.png" />
  <div class="artist">Artist</div>
  <div class="song-name">Song name</div>
  <div class="_10-47">10:47</div>
  <img class="vector" src="/spotify/img/spotify.png" />
  <!-- TODO: add a back button -->
  <div class="rectangle-21"></div>
  <img class="history-1" src="/spotify/img/history.png" />
  <div class="rectangle-19"></div>
  <img class="search-1" src="/spotify/img/search.png" />
  <div class="rectangle-18"></div>
  <img class="heart-2-1" src="/spotify/img/heart-2.png" />
  <div class="rectangle-20"></div>
  <img class="list-text-1" src="/spotify/img/list-text.png" />

  <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png"></img>
</div>

</body>
</html>