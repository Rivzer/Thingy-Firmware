<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/clock/css/style.css">
    <link rel="stylesheet" href="/global.css">
    <title>Clock</title>
</head>

<body>
    <div class="clock">
        <img class="background-image" id="pictureFrame" src="/picture-frame/imgs/example.jpg"></img>
        <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png"></img>
    </div>

    <script>
        const images = [
            '/picture-frame/imgs/example.jpg',
            '/picture-frame/imgs/example1.jpg',
            '/picture-frame/imgs/example2.jpg',
            '/picture-frame/imgs/example3.jpg',
            '/picture-frame/imgs/example4.jpg',
            '/picture-frame/imgs/example5.jpg'
        ];
        
        let currentIndex = 0;
        const imgElement = document.getElementById('pictureFrame');
        
        function cycleImage() {
            currentIndex = (currentIndex + 1) % images.length;
            imgElement.src = images[currentIndex];
        }
        
        setInterval(cycleImage, 1000);
    </script>
</body>

</html>