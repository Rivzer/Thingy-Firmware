<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/picture-frame/css/style.css">
    <link rel="stylesheet" href="/global.css">
    <title>Picture Frame</title>
</head>

<body>
    <div class="picture-frame">
        <img class="background-image" id="picture" src="/picture-frame/imgs/example.jpg">
        <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png">
    </div>

    <script>
        const images = [
            '/picture-frame/imgs/example.jpg',
            '/picture-frame/imgs/example3.jpg',
            '/picture-frame/imgs/example4.jpg',
            '/picture-frame/imgs/example5.jpg'
        ];
        
        let currentIndex = 0;
        const imgElement = document.getElementById('picture');
        
        function cycleImage() {
            currentIndex = (currentIndex + 1) % images.length;
            imgElement.src = images[currentIndex];
        }
        
        setInterval(cycleImage, 15000);
    </script>
</body>

</html>