<!DOCTYPE html>
<html lang="en">

<head>
    <title>Thingy Spotify Player</title>
    <link rel="stylesheet" href="/spotify/css/style.css">
    <link rel="stylesheet" href="/global.css">
</head>

<body>

    <!-- LOGIN / QR SECTION -->
    <div id="loginSection"
        style="text-align:center; color:white; background:#111; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center;">
        <h1>Scan to log in</h1>
        <img id="qrImg" width="250" style="border-radius:16px; margin-bottom:12px;">
        <p id="qrUrl" style="font-size:12px; opacity:0.4;"></p>
    </div>

    <!-- PLAYER SECTION -->
    <div id="playerSection" style="display:none;">
        <div class="spotify-song-playing">
            <!-- times -->
            <div id="totalTime" class="_3-23">0:00</div>
            <div id="currentTime" class="_1-34">0:00</div>

            <!-- progress bar background + fill -->
            <div class="rectangle-16"></div>
            <div class="rectangle-17" id="progressFill"></div>
            <input id="timeline" type="range" min="0" max="100" value="0" class="timeline-input">

            <!-- transport controls -->
            <img id="prevBtn" class="forward-button-2" src="/spotify/img/forward-button.png" />
            <img id="playBtn" class="play-1-1" src="/spotify/img/play.png" data-play="/spotify/img/play.png"
                data-pause="/spotify/img/pause.png" />
            <img id="nextBtn" class="forward-button-1" src="/spotify/img/forward-button.png" />

            <!-- album cover -->
            <div class="rectangle-15">
                <img id="cover" class="album-cover" src="" alt="Album cover" />
            </div>

            <!-- optional small text -->
            <div class="_10-47">10:47</div>

            <!-- spotify logo -->
            <img class="vector" src="/spotify/img/spotify.png" />

            <!-- back button to dashboard -->
            <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png"></img>

            <!-- liked indicator (heart) -->
            <img id="likeBtn" src="" class="ellipse-3" />

            <!-- artist + track -->
            <div id="artist" class="tracy-chapman">Artist</div>
            <div id="track" class="fast-car">Track title</div>

            <!-- volume bar -->
            <div class="rectangle-52"></div>
            <div class="rectangle-53" id="volumeFill"></div>
            <div class="ellipse-3" id="volumeKnob"></div>
            <input id="volumeSlider" type="range" min="0" max="100" value="50" class="volume-slider">
        </div>
    </div>

    <script>
        function msToTime(ms) {
            const m = Math.floor(ms / 60000);
            const s = Math.floor((ms % 60000) / 1000);
            return `${m}:${s.toString().padStart(2, '0')}`;
        }

        let currentTrackId = "";
        let lastProgress = 0;
        let lastTimestamp = 0;
        let trackDuration = 0;
        let isPlaying = false; // from Spotify

        async function checkLoginState() {
            const r = await fetch("/api/state");
            const d = await r.json();

            if (d.loggedIn) {
                document.getElementById("loginSection").style.display = "none";
                document.getElementById("playerSection").style.display = "block";
                refreshPlayer(); // initial load
            } else {
                document.getElementById("loginSection").style.display = "flex";
                document.getElementById("playerSection").style.display = "none";
                loadQR();
            }
        }

        async function loadQR() {
            const r = await fetch("/api/qr");
            const d = await r.json();
            document.getElementById("qrImg").src = d.qr;
            document.getElementById("qrUrl").innerText = d.url;
        }

        async function refreshPlayer() {
            const r = await fetch("/api/playback");
            const d = await r.json();
            const playBtn = document.getElementById("playBtn");

            if (!d || (!d.track && !d.artist)) {
                document.getElementById("track").innerText = "Episode playing";
                document.getElementById("artist").innerText = "No details available from Spotify";
                return;
            }

            // Sync play/pause icon with real Spotify state
            if (playBtn) {
                if (d.isPlaying) {
                    playBtn.src = playBtn.dataset.pause;
                } else {
                    playBtn.src = playBtn.dataset.play;
                }
            }

            currentTrackId = d.id || "";
            document.getElementById("track").innerText = d.track || "-";
            document.getElementById("artist").innerText = d.artist || "-";

            if (d.cover) {
                document.getElementById("cover").src = d.cover;
            }

            const timeline = document.getElementById("timeline");
            const progressFill = document.getElementById("progressFill");

            trackDuration = d.duration || 0;
            lastProgress = d.progress || 0;
            lastTimestamp = Date.now();
            isPlaying = !!d.isPlaying;

            if (timeline) {
                timeline.max = trackDuration || 0;
                timeline.value = lastProgress || 0;
            }

            document.getElementById("currentTime").innerText = msToTime(lastProgress);
            document.getElementById("totalTime").innerText = msToTime(trackDuration);

            // update white fill bar
            if (progressFill) {
                if (trackDuration > 0) {
                    const fraction = lastProgress / trackDuration;
                    const fullWidth = 688; // same as rectangle-16
                    progressFill.style.width = `${fullWidth * fraction}px`;
                } else {
                    progressFill.style.width = "0px";
                }
            }

            // volume from backend
            if (typeof d.volume === "number") {
                updateVolumeUI(d.volume);
            }

            // like button visibility
            const likeBtn = document.getElementById("likeBtn");
            if (likeBtn) {
                if (d.type === "track") {
                    likeBtn.style.display = "inline-block";
                    likeBtn.src = d.liked ? "/spotify/img/like-active.svg" : "/spotify/img/like-not-active.svg";
                } else {
                    likeBtn.style.display = "none";
                }
            }
        }

        function smoothUpdate() {
            const timeline = document.getElementById("timeline");
            const progressFill = document.getElementById("progressFill");
            if (!timeline || !trackDuration) return;

            let current = lastProgress;

            if (isPlaying) {
                const elapsed = Date.now() - lastTimestamp;
                current = lastProgress + elapsed;
                if (current > trackDuration) current = trackDuration;
            }

            timeline.value = current;
            document.getElementById("currentTime").innerText = msToTime(current);

            if (progressFill && trackDuration > 0) {
                const fraction = current / trackDuration;
                const fullWidth = 688;
                progressFill.style.width = `${fullWidth * fraction}px`;
            }
        }

        function updateVolumeUI(volumePercent) {
            const fill = document.getElementById("volumeFill");
            const knob = document.getElementById("volumeKnob");
            const slider = document.getElementById("volumeSlider");

            if (volumePercent == null || !fill || !knob || !slider) return;

            const v = Math.min(100, Math.max(0, volumePercent));
            slider.value = v;

            const trackHeight = 262;   // rectangle-52 height
            const trackTop = 77;       // rectangle-52 top

            // Volume 0 = bottom, 100 = top
            const fillHeight = (v / 100) * trackHeight;
            const fillTop = trackTop + (trackHeight - fillHeight);

            fill.style.height = `${fillHeight}px`;
            fill.style.top = `${fillTop}px`;

            const knobHeight = 30;
            const knobTop = fillTop - (knobHeight / 2);
            knob.style.top = `${knobTop}px`;
        }

        document.addEventListener("DOMContentLoaded", () => {
            const timeline = document.getElementById("timeline");
            const likeBtn = document.getElementById("likeBtn");
            const prevBtn = document.getElementById("prevBtn");
            const playBtn = document.getElementById("playBtn");
            const nextBtn = document.getElementById("nextBtn");
            const volumeSlider = document.getElementById("volumeSlider");

            // seek
            if (timeline) {
                timeline.addEventListener("input", function () {
                    fetch(`/api/seek?position=${this.value}`);
                    lastProgress = Number(this.value);
                    lastTimestamp = Date.now();

                    const progressFill = document.getElementById("progressFill");
                    if (progressFill && trackDuration > 0) {
                        const fraction = lastProgress / trackDuration;
                        const fullWidth = 688;
                        progressFill.style.width = `${fullWidth * fraction}px`;
                    }
                });
            }

            // like / unlike
            if (likeBtn) {
                likeBtn.addEventListener("click", async () => {
                    if (!currentTrackId) return;
                    
                    const isLiked = likeBtn.src.includes("like-active.svg");
                    // TODO: unlike doesnt sync with spotify
                    try {
                        if (isLiked) {
                            await fetch(`/api/unlike?track=${currentTrackId}`);
                        } else {
                            await fetch(`/api/like?track=${currentTrackId}`);
                        }
                        setTimeout(refreshPlayer, 100);
                    } catch (e) {
                        console.error("Like/unlike failed:", e);
                    }
                });
            }

            // volume slider
            if (volumeSlider) {
                volumeSlider.addEventListener("input", () => {
                    const raw = Number(volumeSlider.value);
                    const volume = 100 - raw; // invert if you use scaleY(-1)
                    updateVolumeUI(volume);
                    fetch(`/api/volume?percent=${volume}`).catch(() => { });
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener("click", async () => {
                    try {
                        await fetch("/api/prev");
                        setTimeout(refreshPlayer, 300); // snel herladen na vorige track
                    } catch (e) {
                        console.error(e);
                    }
                });
            }

            if (playBtn) {
                playBtn.addEventListener("click", async () => {
                    try {
                        await fetch("/api/playpause");
                        setTimeout(refreshPlayer, 300); // snel herladen na play/pause
                    } catch (e) {
                        console.error(e);
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener("click", async () => {
                    try {
                        await fetch("/api/next");
                        setTimeout(refreshPlayer, 300); // snel herladen na volgende track
                    } catch (e) {
                        console.error(e);
                    }
                });
            }

        });

        const POLL_INTERVAL = 1000;
        setInterval(refreshPlayer, POLL_INTERVAL);
        setInterval(smoothUpdate, 100);


        checkLoginState();
    </script>

</body>

</html>