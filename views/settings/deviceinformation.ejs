<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/global.css">
    <link rel="stylesheet" href="/settings/css/deviceinformation.css">
</head>

<body>
    <div class="settings-device-information">
        <img onclick="history.back()" class="back-button" src="/spotify/img/turn-back.png">

        <div class="device-information-title">Device Information</div>

        <div class="info-list">

            <!-- Wifi configured / internet status -->
            <div class="info-row">
                <span class="info-label">WiFi</span>
                <span class="info-value <%= internetOnline ? 'status-ok' : 'status-bad' %>">
                    <%= internetOnline ? 'Connected' : 'Not connected' %>
                </span>
            </div>

            <!-- IPv4 -->
            <div class="info-row">
                <span class="info-label">IPv4</span>
                <span class="info-value">
                    <%= ip || '0.0.0.0' %>
                </span>
            </div>

            <!-- Device -->
            <div class="info-row">
                <span class="info-label">Device</span>
                <span class="info-value">
                    <%= device.device_name || 'Raspberry Pi Zero 2 W' %>
                </span>
            </div>

            <!-- Authors -->
            <div class="info-row">
                <span class="info-label">Authors</span>
                <span class="info-value">Kyano &amp; Josef</span>
            </div>

            <!-- Firmware -->
            <div class="info-row">
                <span class="info-label">Firmware</span>
                <span class="info-value">
                    <% if (firmware && firmware.version) { %>
                        <%= firmware.version %>
                            <% } else { %>
                                unknown
                                <% } %>
                </span>
            </div>
        </div>
    </div>

    <script>
        // Ververs elke 10 seconden (10.000 ms)
        setInterval(() => {
            window.location.reload();
        }, 10000);
    </script>

</body>

</html>