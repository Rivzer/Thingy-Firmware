<style>
    .console-deck-console,
    .console-deck-console * {
        box-sizing: border-box;
    }

    .console-deck-console {
        background: #202125;
        position: relative;
        overflow: hidden;
        font-family: system-ui, sans-serif;
        color: #fff;
    }

    .tile {
        width: 125px;
        height: 125px;
        border-radius: 15px;
        position: absolute;
        overflow: hidden;
        cursor: pointer;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }


    .tile-inner {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 5px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    }

    .tile img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        margin-bottom: 6px;
    }

    .tile-name {
        font-size: 0.75rem;
        font-weight: bold;
        text-shadow: 0 1px 2px black;
    }

    .tile-sub {
        font-size: 0.6rem;
        color: #ddd;
        text-shadow: 0 1px 2px black;
    }

    .tile.selected {
        box-shadow: 0 0 0 3px #1db954;
    }

    .turn-back {
        width: 48px;
        height: 48px;
        position: absolute;
        right: 30px;
        top: 16px;
        cursor: pointer;
    }
</style>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/global.css">
    <!-- TODO: fix the height issue !-->
    <title>Console deck</title>
</head>
<body>
    <% const slots=[ { cls: "rectangle-37" , left: 50, top: 27 }, { cls: "rectangle-38" , left: 50, top: 177 }, {
        cls: "rectangle-43" , left: 50, top: 327 }, { cls: "rectangle-39" , left: 223, top: 27 }, { cls: "rectangle-41" ,
        left: 223, top: 177 }, { cls: "rectangle-42" , left: 223, top: 327 }, { cls: "rectangle-44" , left: 396, top: 27 },
        { cls: "rectangle-45" , left: 396, top: 177 }, { cls: "rectangle-46" , left: 396, top: 327 }, { cls: "rectangle-50"
        , left: 569, top: 27 }, { cls: "rectangle-48" , left: 569, top: 177 }, { cls: "rectangle-49" , left: 569, top: 327 }
        ]; const list=Array.isArray(apps) ? apps.slice(0, 12) : []; %>

        <div class="console-deck-console" id="consoleDeck">

            <% list.forEach((app, index)=> {
                const slot = slots[index];
                const showLabel = (app.showLabel !== false); // default = aan
                %>
                <div class="tile <%= selectedAppId === app.id ? 'selected' : '' %>" style="
                left:<%= slot.left %>px;
                top:<%= slot.top %>px;
                background-image:url('<%= app.icon %>');
            " data-app-id="<%= app.id %>">

                    <% if (showLabel) { %>
                        <div class="tile-inner">
                            <div class="tile-name">
                                <%= app.name %>
                            </div>
                            <div class="tile-sub">
                                <%= app.category || '' %>
                            </div>
                        </div>
                        <% } %>

                </div>
                <% }) %>


                <!-- Back button -->
                <img class="turn-back" src="/spotify/img/turn-back.png" onclick="history.back()">
    </div>

    <script>
        const deck = document.getElementById('consoleDeck');

        deck.addEventListener('click', (e) => {
            const tile = e.target.closest('.tile');
            if (!tile) return;

            const appId = tile.dataset.appId;
            if (!appId) return;

            console.log("Clicked app:", appId);

            // Select visual
            document.querySelectorAll('.tile').forEach(t => t.classList.remove('selected'));
            tile.classList.add('selected');

            // (later) open/select API call
            // fetch('/api/consoledeck/select', { ... })
        });
    </script>
</body>
</html>